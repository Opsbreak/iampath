      "tool": {
        "driver": {
          "informationUri": "https://github.com/Opsbreak/iampath",
          "name": "iampath",
          "rules": [
            {
              "id": "CB-001",
              "name": "CodeBuildStartBuildbuildspecoverride",
              "shortDescription": {
                "text": "Start a build of an existing project with an attacker-supplied buildspec."
              },
              "fullDescription": {
                "text": "--buildspec-override runs arbitrary commands with the project's service role."
              },
              "help": {
                "text": "Remediation: Restrict codebuild:StartBuild on privileged projects and keep service roles least-privilege."
              },
              "properties": {
                "category": "compute-hijack",
                "requiredPermissions": [
                  "codebuild:StartBuild"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "IAM-001",
              "name": "CreatePolicyVersion",
              "shortDescription": {
                "text": "Create a new default version of a customer managed policy attached to the principal."
              },
              "fullDescription": {
                "text": "iam:CreatePolicyVersion with --set-as-default replaces the effective content of the policy without needing iam:SetDefaultPolicyVersion. Anyone who can do this on a policy attached to themselves (directly or via a group) can grant themselves Action:* on Resource:*."
              },
              "help": {
                "text": "Remediation: Never grant iam:CreatePolicyVersion on policies attached to the same principal. Scope the action to specific policy ARNs owned by a deployment pipeline, and alert on CreatePolicyVersion events in CloudTrail."
              },
              "properties": {
                "category": "permission-modification",
                "requiredPermissions": [
                  "iam:CreatePolicyVersion"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "IAM-002",
              "name": "SetDefaultPolicyVersion",
              "shortDescription": {
                "text": "Roll an attached managed policy back to an older, more permissive non-default version."
              },
              "fullDescription": {
                "text": "Managed policies keep up to five versions. If an older version was broader (a common leftover after tightening a policy), switching the default version silently restores those permissions."
              },
              "help": {
                "text": "Remediation: Delete unused non-default policy versions and restrict iam:SetDefaultPolicyVersion to administrators."
              },
              "properties": {
                "category": "permission-modification",
                "requiredPermissions": [
                  "iam:SetDefaultPolicyVersion"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "IAM-009",
              "name": "AddUserToGroup",
              "shortDescription": {
                "text": "Add the user to a group whose policies grant administrator access."
              },
              "fullDescription": {
                "text": "Joining an Admins group is a single API call and is easy to miss among routine group changes."
              },
              "help": {
                "text": "Remediation: Scope iam:AddUserToGroup to specific low-privilege groups and alert on changes to privileged groups."
              },
              "properties": {
                "category": "permission-modification",
                "requiredPermissions": [
                  "iam:AddUserToGroup"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "IAM-010",
              "name": "CreateAccessKey",
              "shortDescription": {
                "text": "Create an access key for another IAM user."
              },
              "fullDescription": {
                "text": "Yields long-term credentials for the target user (each user may have two keys; a full key slot blocks it)."
              },
              "help": {
                "text": "Remediation: Restrict iam:CreateAccessKey to user/${aws:username} and prefer IAM Identity Center over IAM users."
              },
              "properties": {
                "category": "credential-access",
                "requiredPermissions": [
                  "iam:CreateAccessKey"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "IAM-013",
              "name": "UpdateAssumeRolePolicy",
              "shortDescription": {
                "text": "Rewrite a role's trust policy to trust the attacker, then assume it."
              },
              "fullDescription": {
                "text": "After naming their own ARN in the trust policy, a same-account principal can assume the role. Only an explicit Deny or an SCP on sts:AssumeRole stops the second step."
              },
              "help": {
                "text": "Remediation: Restrict iam:UpdateAssumeRolePolicy to administrators; monitor trust-policy changes with AWS Config."
              },
              "properties": {
                "category": "role-assumption",
                "requiredPermissions": [
                  "iam:UpdateAssumeRolePolicy",
                  "sts:AssumeRole"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "LAMBDA-001",
              "name": "PassRoleAndLambdaCreateFunctionAndInvokeFunction",
              "shortDescription": {
                "text": "Create a Lambda function with a privileged execution role and invoke it."
              },
              "fullDescription": {
                "text": "The function's code runs with the passed role's permissions and can, for example, attach AdministratorAccess to the attacker's user."
              },
              "help": {
                "text": "Remediation: Scope iam:PassRole to specific role ARNs and add an iam:PassedToService condition; keep Lambda execution roles least-privilege."
              },
              "properties": {
                "category": "passrole-compute",
                "requiredPermissions": [
                  "iam:PassRole",
                  "lambda:CreateFunction",
                  "lambda:InvokeFunction"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "LAMBDA-003",
              "name": "UpdateFunctionCode",
              "shortDescription": {
                "text": "Replace the code of an existing function whose execution role is more privileged."
              },
              "fullDescription": {
                "text": "The new code runs with the function's role on the next invocation; no iam:PassRole is required."
              },
              "help": {
                "text": "Remediation: Restrict lambda:UpdateFunctionCode to deployment pipelines and enable code signing for Lambda."
              },
              "properties": {
                "category": "compute-hijack",
                "requiredPermissions": [
                  "lambda:UpdateFunctionCode"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "SSM-001",
              "name": "SSMSendCommand",
              "shortDescription": {
                "text": "Run commands on an instance whose instance profile role is more privileged."
              },
              "fullDescription": {
                "text": "Commands run as root on the instance and can read the role credentials from IMDS."
              },
              "help": {
                "text": "Remediation: Scope ssm:SendCommand by instance tags/ARNs and documents; avoid privileged instance profiles."
              },
              "properties": {
                "category": "compute-hijack",
                "requiredPermissions": [
                  "ssm:SendCommand"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            },
            {
              "id": "STS-001",
              "name": "AssumeRole",
              "shortDescription": {
                "text": "Assume a role whose trust policy allows the principal."
              },
              "fullDescription": {
                "text": "Trust policies that name the account root delegate the decision to identity policies; broad sts:AssumeRole grants (Resource:*) then expose every such role."
              },
              "help": {
                "text": "Remediation: Name specific principal ARNs in trust policies, add conditions (aws:PrincipalArn, sts:ExternalId, MFA) and scope sts:AssumeRole in identity policies to the roles that are needed."
              },
              "properties": {
                "category": "role-assumption",
                "requiredPermissions": [
                  "sts:AssumeRole"
                ],
                "tags": [
                  "security",
                  "aws",
                  "iam"
                ]
              }
            }
          ],
          "version": "0.1.0"
        }
      }
    }
